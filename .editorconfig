root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 100

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[Kconfig*]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab
